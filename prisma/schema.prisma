generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  firstName    String   @db.VarChar(100)
  lastName     String   @db.VarChar(100)
  email        String   @unique @db.VarChar(254)
  passwordHash String
  createdAt    DateTime @default(now())
}

model Product {
  id             String       @id @db.VarChar(100)
  name           String       @db.VarChar(200)
  description    String       @default("") @db.VarChar(1000)
  imageUrl       String       @default("/assets/images/placeholder.svg") @db.VarChar(500)
  keywords       String[]     @default([])
  isInStock      Boolean      @default(true)
  /// Position in the catalogue; search results keep this order, like the frontend.
  displayOrder   Int          @default(0)
  unitPricePence Int
  basketItems    BasketItem[]
}

model Basket {
  id        String       @id @default(uuid())
  createdAt DateTime     @default(now())
  items     BasketItem[]
}

model BasketItem {
  basketId  String
  productId String   @db.VarChar(100)
  quantity  Int
  addedAt   DateTime @default(now())
  basket    Basket   @relation(fields: [basketId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([basketId, productId])
}
