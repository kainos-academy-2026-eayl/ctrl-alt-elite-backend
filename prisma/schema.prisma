generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
  CUSTOMER_SERVICE
  INVENTORY_MANAGEMENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketCategory {
  ACCOUNT_ISSUE
  ORDER_ISSUE
  DELIVERY_ISSUE
  RETURNS_REFUNDS
  PRODUCT_ENQUIRY
  OTHER
}

model User {
  id           String   @id @default(uuid())
  firstName    String   @db.VarChar(100)
  lastName     String   @db.VarChar(100)
  email        String   @unique @db.VarChar(254)
  passwordHash String
  username     String?  @unique @db.VarChar(30)
  profilePhoto Bytes?
  addressLine1 String?  @db.VarChar(200)
  addressLine2 String?  @db.VarChar(200)
  postcode     String?  @db.VarChar(20)
  phoneNumber  String?  @db.VarChar(30)
  role         Role     @default(CUSTOMER)
  // Spent at checkout. Every account starts with £500.00.
  creditBalancePence Int @default(50000)
  createdAt    DateTime @default(now())
  orders       order[]
  supportTickets SupportTicket[]
  ticketMessages TicketMessage[]
}

model SupportTicket {
  id          String         @id @default(dbgenerated("('T-'::text || (nextval('ticket_number_seq'::regclass))::text)"))
  customerId  String
  customer    User           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  subject     String         @db.VarChar(200)
  category    TicketCategory
  description String         @db.VarChar(10000)
  status      TicketStatus   @default(OPEN)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt
  messages    TicketMessage[]

  @@index([customerId, createdAt, id])
}

model TicketMessage {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body      String        @db.VarChar(10000)
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt, id])
}

model order {
    id           String           @id @default(uuid())
    customerId   String
    customer     User             @relation(fields: [customerId], references: [id])
    order_total  Float
    order_status String
    createdAt    DateTime @default(now())

    // Checkout details. Orders placed before checkout existed have none.
    first_name           String? @db.VarChar(100)
    last_name            String? @db.VarChar(100)
    email                String? @db.VarChar(254)
    phone                String? @db.VarChar(20)
    address_line1        String? @db.VarChar(100)
    address_line2        String? @db.VarChar(100)
    town                 String? @db.VarChar(60)
    postcode             String? @db.VarChar(8)
    delivery_option      String? @db.VarChar(20)
    delivery_price_pence Int     @default(0)
    
    products     order_products[]

    @@index([createdAt, id])
    @@index([order_status, createdAt])
}

model order_products {
    order_id   String
    order      order   @relation(fields: [order_id], references: [id])
    product_id String
    product    Product @relation(fields: [product_id], references: [id])
    amount     Int
    // The price paid, so later price changes do not alter past orders.
    unit_price_pence Int @default(0)

    @@id([order_id, product_id])
}

model Product {
    id           String           @id @default(uuid())
    name         String
    category     String           @default("Uncategorised")
    description  String           @default("")
    price        Float
    stock        Int
    lowStockThreshold Int         @default(10)
    outOfStock   Boolean          @default(false)
    image        Bytes
    createdAt    DateTime @default(now())
    
    orderEntries order_products[]
    basketItems  BasketItem[]
}

model Basket {
  id        String       @id @default(uuid())
  createdAt DateTime     @default(now())
  items     BasketItem[]
}

model BasketItem {
  basketId  String
  productId String
  quantity  Int
  addedAt   DateTime @default(now())
  basket    Basket   @relation(fields: [basketId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([basketId, productId])
}
