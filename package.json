{
  "name": "e-commerce-backend-platform",
  "version": "0.1.0",
  "description": "A backend platform for an e-commerce application",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tswatch src/index.ts",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/index.js --sourcemap",
    "typecheck": "tsc",
    "start": "node dist/index.js"
  },
  
  "keywords": [],
  "author": "Me",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.4.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "express": "5.2.1"
  }
}
